{
  "manifestVersion": 5,
  "id": "com.krugwalk.krugmosh",
  "name": "Krugmosh",
  "version": "1.3.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "krugmoshPanel",
      "label": { "default": "Krugmosh" },
      "minimumSize": { "width": 240, "height": 320 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 560 },
      "preferredFloatingSize": { "width": 320, "height": 600 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["file"],
      "extensions": [".pyw"]
    }
  }
}
